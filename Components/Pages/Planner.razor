@page "/planner"
@using CoiPlanner.Domain.Models
@using CoiPlanner.Domain.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject GameData Data
@inject PlanCalculator Calculator
@inject ProductionPlanSerializer Serializer
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<Planner> Logger
@inject IWebHostEnvironment Env

<PageTitle>產線規劃 - CoiPlanner</PageTitle>

<div class="planner">
    <canvas @ref="_canvas"></canvas>

    <MudTooltip Text="Fit view：顯示整個工作流" Placement="Placement.Left" RootClass="planner-fit">
        <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FitScreen"
                OnClick="FitViewAsync" Disabled="_editor is null" aria-label="Fit view" />
    </MudTooltip>

    @* 右上角：模擬控制 *@
    <MudPaper Class="planner-sim-bar" Elevation="4">
        <MudTooltip Text="@(_running ? "暫停" : "播放")">
            <MudIconButton Icon="@(_running ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                           Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                           OnClick="() => _running = !_running" aria-label="@(_running ? "暫停" : "播放")" />
        </MudTooltip>
        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
            @foreach (var speed in Speeds)
            {
                <MudButton Variant="@(_speed == speed ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                           OnClick="() => _speed = speed">@(speed)×</MudButton>
            }
        </MudButtonGroup>
        <MudTooltip Text="重置模擬">
            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" OnClick="ResetSimulation" aria-label="重置模擬" />
        </MudTooltip>
        <MudText Typo="Typo.body2" Class="planner-sim-clock">@FormatTime(_snapshot?.TimeSeconds ?? 0)</MudText>
    </MudPaper>

    @* 右側：面板切換按鈕；一次只開一個面板，再按一次收合 *@
    <div class="planner-side-buttons">
        <MudTooltip Text="產線規劃（說明、匯入匯出、問題）" Placement="Placement.Left">
            <MudFab Color="@(_panel == SidePanel.Plan ? Color.Primary : Color.Default)" Class="@IdleClass(SidePanel.Plan)" Size="Size.Small"
                    StartIcon="@Icons.Material.Filled.Assessment" OnClick="() => TogglePanel(SidePanel.Plan)" aria-label="產線規劃面板" />
        </MudTooltip>
        <MudTooltip Text="物料平衡" Placement="Placement.Left">
            <MudFab Color="@(_panel == SidePanel.Balance ? Color.Primary : Color.Default)" Class="@IdleClass(SidePanel.Balance)" Size="Size.Small"
                    StartIcon="@Icons.Material.Filled.TableChart" OnClick="() => TogglePanel(SidePanel.Balance)" aria-label="物料平衡面板" />
        </MudTooltip>
    </div>

    @* 用 d-none 隱藏而不是不渲染：檔案上傳元件要一直存在，匯入才不會因為面板收合而失效 *@
    <MudPaper Class="@($"planner-side pa-4 {(_panel == SidePanel.Plan ? "" : "d-none")}")" Elevation="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">產線規劃</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _panel = SidePanel.None" aria-label="收合面板" />
        </MudStack>
        <MudText Typo="Typo.caption" Class="d-block mb-3">
            在畫布按右鍵 → Add Node，或連點兩下搜尋，新增機器或資源。拖動輸出插槽到同一物品的輸入插槽建立連線；同一個輸入可以接多條線合流。
            連線中間顯示「流量/上限」（每分鐘，同一來源有多條線時依建立順序填滿），達到上限時以紅色粗體標示；點它可以選擇運輸等級或刪除連線。選取節點後按 Delete，或在節點上按右鍵 → Remove 刪除。
            按住 Shift 移動或調整節點大小會對齊格線；右下角的按鈕可以把視野移到整個工作流。
        </MudText>

        <MudStack Row="true" Spacing="1" Class="mb-1">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download"
                       OnClick="ExportAsync" Disabled="_editor is null">匯出</MudButton>
            <MudFileUpload @ref="_upload" T="IBrowserFile" Accept=".json" FilesChanged="ImportAsync" Disabled="_editor is null">
                <CustomContent>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Upload"
                               OnClick="@context.OpenFilePickerAsync" Disabled="_editor is null">匯入</MudButton>
                </CustomContent>
            </MudFileUpload>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep"
                       OnClick="ClearAsync" Disabled="_editor is null || IsEmpty(_plan)">清空</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-4">也可以把 .json 檔直接拖到畫布上匯入。修改會自動存在這個瀏覽器中。</MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-1">模擬</MudText>
        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-4">
            右上角可以暫停、切換速度、重置。每個節點獨立運作：輸入都有料後等 @Format(_sim.Settings.StartupSeconds) 秒才開始生產，缺料或輸出堵塞就停擺。正常生產為綠色、減產為黃色，停擺或連線有問題的機器標紅。
            暫存 @Format(_sim.Settings.BufferMinutes) 分鐘用量、運送 @Format(_sim.Settings.TransitSeconds) 秒；沒接線的輸出送進倉庫。
            數字為最近 @Format(_sim.Settings.AverageSeconds) 秒的平均。
        </MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-1">問題</MudText>
        @if (_result is null || _result.IsValid)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">沒有問題。</MudText>
        }
        else
        {
            @foreach (var issue in _result.Issues)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-1">@issue.Message</MudAlert>
            }
        }
    </MudPaper>

    @if (_panel == SidePanel.Balance)
    {
        <MudPaper Class="planner-side pa-4" Elevation="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">物料平衡</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => _panel = SidePanel.None" aria-label="收合面板" />
            </MudStack>
            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-2">
                每分鐘的實際產出與消耗（最近 @Format(_sim.Settings.AverageSeconds) 秒平均）。
            </MudText>
            @if (_snapshot is null || _snapshot.Balances.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">尚無節點。</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>物品</th>
                            <th style="text-align:right">產出</th>
                            <th style="text-align:right">消耗</th>
                            <th style="text-align:right">差額</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in _snapshot.Balances)
                        {
                            <tr>
                                <td>@ProductName(b.ProductId)</td>
                                <td style="text-align:right">@FormatRate(b.SupplyPerMinute)</td>
                                <td style="text-align:right">@FormatRate(b.DemandPerMinute)</td>
                                <td style="text-align:right">
                                    <MudText Typo="Typo.body2" Color="@NetColor(b.NetPerMinute)">@FormatRate(b.NetPerMinute)</MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    }
</div>

@code {
    private const string StorageKey = "coiplanner.plan";
    private const long MaxImportBytes = 1024 * 1024;
    private static readonly int[] Speeds = [1, 5, 10, 20];
    // 每 100 毫秒推進一次模擬並把狀態送到畫布；1× 時正好是一步（0.1 秒）
    private static readonly TimeSpan TickInterval = TimeSpan.FromMilliseconds(100);
    // 面板（模擬時間、物料平衡表）每幾次更新重繪一次，畫布則每次都更新
    private const int PanelRefreshTicks = 3;

    private ElementReference _canvas;
    private MudFileUpload<IBrowserFile>? _upload;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private DotNetObjectReference<Planner>? _dotnetRef;
    private ProductionPlan _plan = new();
    private PlanResult? _result;
    private Dictionary<string, Product> _products = new();
    private HashSet<(string MachineId, string RecipeId)> _nodeTypes = new();
    private enum SidePanel { None, Plan, Balance }

    // 一開始收起面板，畫布不被遮住；需要時按右側按鈕打開
    private SidePanel _panel = SidePanel.None;

    private readonly ProductionSimulator _sim = new();
    private SimulationSnapshot? _snapshot;
    private bool _running = true;
    private int _speed = 1;
    private int _tick;
    private readonly CancellationTokenSource _loopCts = new();
    // 匯入或清空後，下一次收到畫布的規劃時讓模擬從頭開始
    private bool _resetOnNextChange;

    // 載入（自動存檔或匯入）的規劃，等畫布回報結果後用來比對有沒有被略過的節點或連線
    private ProductionPlan? _pendingLoad;

    protected override void OnInitialized()
    {
        _products = Data.Products.ToDictionary(p => p.Id);
        _nodeTypes = Data.Machines.SelectMany(m => m.RecipeIds.Select(r => (m.Id, r))).ToHashSet();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var saved = await ReadAutosaveAsync();
        _pendingLoad = IsEmpty(saved) ? null : saved;

        _dotnetRef = DotNetObjectReference.Create(this);
        // 加上檔案修改時間當版本號，JS 更新後瀏覽器才不會繼續用快取裡的舊模組
        var version = Env.WebRootFileProvider.GetFileInfo("js/graphEditor.js").LastModified.ToUnixTimeSeconds();
        _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/graphEditor.js?v={version}");
        _editor = await _module.InvokeAsync<IJSObjectReference>("createEditor", _canvas, _dotnetRef, BuildCatalog(), saved, MaxImportBytes);
        // 第一次 OnGraphChanged 可能比 createEditor 先回來，那時還沒有 _editor 可以顯示結果
        if (_result is not null)
            await _editor.InvokeVoidAsync("applyResult", _result);
        StateHasChanged();

        _ = RunSimulationAsync(_loopCts.Token);
    }

    private async Task RunSimulationAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TickInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(SimulationTickAsync);
        }
        catch (OperationCanceledException)
        {
            // 離開頁面
        }
    }

    private async Task SimulationTickAsync()
    {
        if (_editor is null || _loopCts.IsCancellationRequested)
            return;

        try
        {
            if (_running)
                _sim.Run(TickInterval.TotalSeconds * _speed);
            _snapshot = _sim.Snapshot();
            await _editor.InvokeVoidAsync("applySimulation", _snapshot);
            if (++_tick % PanelRefreshTicks == 0)
                StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            _loopCts.Cancel();
        }
        catch (Exception ex) when (!_loopCts.IsCancellationRequested)
        {
            // 模擬出錯時停下來並提示，不能讓 circuit 中斷
            Logger.LogError(ex, "模擬失敗");
            _running = false;
            Snackbar.Add($"模擬發生錯誤，已暫停：{ex.Message}", Severity.Error);
        }
    }

    // 畫布右側被蓋住的寬度，fit view 時要避開：右側按鈕欄（含間距 68px），面板展開時再加上面板 360px 與間距
    private const int ButtonsInset = 68;
    private const int PanelInset = ButtonsInset + 360 + 12;

    private void TogglePanel(SidePanel panel) => _panel = _panel == panel ? SidePanel.None : panel;

    // 沒開啟的面板按鈕用淺色底，在深色畫布上才看得到
    private string IdleClass(SidePanel panel) => _panel == panel ? "" : "planner-side-button-idle";

    private async Task FitViewAsync()
    {
        if (_editor is not null)
            await _editor.InvokeVoidAsync("fitView", _panel == SidePanel.None ? ButtonsInset : PanelInset);
    }

    private void ResetSimulation()
    {
        _sim.Reset();
        _snapshot = _sim.Snapshot();
    }

    [JSInvokable]
    public async Task OnGraphChanged(ProductionPlan plan)
    {
        _plan = plan;
        _result = Calculator.Calculate(plan);
        _sim.Sync(plan, _result);
        if (_resetOnNextChange)
        {
            _resetOnNextChange = false;
            ResetSimulation();
        }
        if (_editor is not null)
            await _editor.InvokeVoidAsync("applyResult", _result);

        if (_pendingLoad is not null)
        {
            ReportDropped(_pendingLoad, plan);
            _pendingLoad = null;
        }

        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, Serializer.Serialize(plan));
        StateHasChanged();
    }

    private async Task<ProductionPlan> ReadAutosaveAsync()
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (string.IsNullOrEmpty(json))
            return new ProductionPlan();

        try
        {
            return Serializer.Deserialize(json);
        }
        catch (GameDataException)
        {
            Snackbar.Add("自動存檔無法讀取，已改用空白規劃。", Severity.Warning);
            return new ProductionPlan();
        }
    }

    private async Task ExportAsync()
    {
        var fileName = $"coiplanner-plan-{DateTime.Now:yyyyMMdd-HHmm}.json";
        await _module!.InvokeVoidAsync("downloadText", fileName, Serializer.Serialize(_plan));
    }

    private async Task ImportAsync(IBrowserFile? file)
    {
        if (file is null || _editor is null)
            return;

        string text;
        try
        {
            using var reader = new StreamReader(file.OpenReadStream(MaxImportBytes));
            text = await reader.ReadToEndAsync();
        }
        catch (IOException)
        {
            Snackbar.Add($"檔案太大，上限為 {MaxImportBytes / 1024} KB。", Severity.Error);
            return;
        }
        catch (Exception ex)
        {
            // 任何未預期的錯誤都不能讓 circuit 中斷，記錄下來並提示使用者
            Logger.LogError(ex, "讀取 {FileName} 失敗", file.Name);
            Snackbar.Add($"無法匯入 {file.Name}：{ex.GetType().Name}: {ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            // 清掉選取，否則再選同一個檔案不會觸發 FilesChanged
            if (_upload is not null)
                await _upload.ClearAsync();
        }

        await ImportTextAsync(file.Name, text);
    }

    /// <summary>
    /// 把 .json 檔拖到畫布上匯入。不會開啟檔案選擇視窗：
    /// Visual Studio 偵錯時，部分瀏覽器關閉檔案選擇視窗後 VS 會誤判瀏覽器已關閉而停止偵錯。
    /// </summary>
    [JSInvokable]
    public Task OnFileDropped(string fileName, string text) => ImportTextAsync(fileName, text);

    private async Task ImportTextAsync(string fileName, string text)
    {
        if (_editor is null)
            return;

        ProductionPlan plan;
        try
        {
            plan = Serializer.Deserialize(text);
        }
        catch (GameDataException ex)
        {
            Snackbar.Add($"無法匯入 {fileName}：{ex.Message}", Severity.Error);
            return;
        }

        _pendingLoad = plan;
        _resetOnNextChange = true;
        await _editor.InvokeVoidAsync("load", plan);
        Snackbar.Add($"已匯入 {fileName}。", Severity.Success);
    }

    private async Task ClearAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "清空規劃", "確定要刪除所有節點與連線嗎？此動作無法復原。", yesText: "清空", cancelText: "取消");
        if (confirmed == true && _editor is not null)
        {
            _resetOnNextChange = true;
            await _editor.InvokeVoidAsync("load", new ProductionPlan());
        }
    }

    /// <summary>
    /// 畫布只會建立目前資料認得的節點類型，且一個輸入插槽只能接一條線；
    /// 載入後比對數量，讓使用者知道有東西沒被載入。
    /// </summary>
    private void ReportDropped(ProductionPlan requested, ProductionPlan loaded)
    {
        var droppedNodes = requested.Nodes.Count + requested.Sources.Count - loaded.Nodes.Count - loaded.Sources.Count;
        var droppedEdges = requested.Edges.Count - loaded.Edges.Count;
        if (droppedNodes <= 0 && droppedEdges <= 0)
            return;

        var unknown = requested.Nodes.Count(n => !_nodeTypes.Contains((n.MachineId, n.RecipeId)))
            + requested.Sources.Count(s => !_products.ContainsKey(s.ProductId));
        var parts = new List<string>();
        if (droppedNodes > 0)
            parts.Add($"{droppedNodes} 個節點（其中 {unknown} 個的機器、配方或物品不在目前資料中）");
        if (droppedEdges > 0)
            parts.Add($"{droppedEdges} 條連線");
        Snackbar.Add($"載入時略過了 {string.Join("、", parts)}。", Severity.Warning);
    }

    /// <summary>每個「機器 × 可執行配方」組合是一種節點類型。</summary>
    private object BuildCatalog() => new
    {
        NodeTypes = Data.Machines
            .SelectMany(m => m.RecipeIds.Select(id => (Machine: m, Recipe: Data.Recipes.First(r => r.Id == id))))
            .Select(x => new
            {
                MachineId = x.Machine.Id,
                MachineName = x.Machine.Name,
                RecipeId = x.Recipe.Id,
                RecipeName = x.Recipe.Name,
                Inputs = x.Recipe.Inputs.Select(i => Slot(i.ProductId)),
                Outputs = x.Recipe.Outputs.Select(o => Slot(o.ProductId)),
            }),
        // 每個物品都可以放一個資源來源節點
        Products = Data.Products.Select(p => Slot(p.Id)),
        Transports = Data.Transports.Select(t => new { t.Id, t.Name, t.Kind, t.TiersPerMinute }),
    };

    private object Slot(string productId) => new
    {
        ProductId = productId,
        Name = _products[productId].Name,
        Unit = _products[productId].Unit,
        Kind = _products[productId].Kind,
    };

    private static bool IsEmpty(ProductionPlan plan) => plan.Nodes.Count == 0 && plan.Sources.Count == 0;

    private string ProductName(string id) => _products.TryGetValue(id, out var p) ? p.Name : id;

    private static string Format(double value) => value.ToString("0.##");

    private static string FormatTime(double seconds) =>
        TimeSpan.FromSeconds(Math.Floor(seconds)).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"mm\:ss");

    // 模擬的速率是移動平均，會在整數附近小幅浮動；顯示到小數一位，差距在 0.05 以內視為平衡
    private const double BalanceTolerance = 0.05;

    private static string FormatRate(double value) =>
        (Math.Abs(value) < BalanceTolerance ? 0 : value).ToString("0.#");

    private static Color NetColor(double net) =>
        net < -BalanceTolerance ? Color.Error : net > BalanceTolerance ? Color.Success : Color.Default;

    public async ValueTask DisposeAsync()
    {
        _loopCts.Cancel();
        try
        {
            if (_editor is not null)
            {
                await _editor.InvokeVoidAsync("dispose");
                await _editor.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // 連線已中斷時瀏覽器端的物件已經不存在，不需要清理
        }
        _dotnetRef?.Dispose();
        _loopCts.Dispose();
    }
}
