@page "/cost"
@using CoiPlanner.Domain.Models
@using CoiPlanner.Domain.Services
@inject GameData Data
@inject RecipeCostCalculator Calculator
@inject BrowserStorage Storage
@* 配方成本頁（整頁滿版）：選一個物品，列出每個能產出它的配方，比較每 1 單位的原料（加權）、副產品，以及耗電、工人、維修。
   計算在 RecipeCostCalculator；選擇的物品、原料權重與指定的做法存在瀏覽器（BrowserStorage，不屬於規劃檔），離開頁面再回來還在。 *@
<PageTitle>配方成本 - CoiPlanner</PageTitle>

<div class="cost-page">
    <MudText Typo="Typo.h5" GutterBottom="true">配方成本</MudText>
    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-2">
        選一個物品，比較各種配方。原料與副產品是每 1 單位目標物品的量；耗電、工人、維修、機器是維持 1 單位/分產量所需。
        副產品的原料成本全部算在目標物品上；中間物品有多種做法時預設取加權成本最低的，下面可以指定改用哪一個。
    </MudText>

    <MudAutocomplete T="string" Label="目標物品" Placeholder="輸入名稱搜尋" Value="_productId" ValueChanged="OnProductChosen"
                     SearchFunc="Search" ToStringFunc="ProductName" Dense="true" Clearable="true" CoerceText="false" CoerceValue="false"
                     ResetValueOnEmptyText="true" MaxItems="60" Class="mb-2 cost-product" aria-label="目標物品" />

    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mb-1"
               StartIcon="@(_showWeights ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
               OnClick="() => _showWeights = !_showWeights">原料權重（預設 1，影響加權成本與排序）</MudButton>
    <MudCollapse Expanded="_showWeights">
        <div class="cost-weights">
            @foreach (var id in Calculator.RawProductIds)
            {
                var rawId = id;
                <MudNumericField T="double" Label="@(ProductName(rawId) + (Calculator.IsExternal(rawId) ? "（外部）" : ""))" Value="WeightOf(rawId)"
                                 ValueChanged="v => OnWeightChanged(rawId, v)" Min="0" Step="0.5" Immediate="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
            }
        </div>
        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-2">
            「外部」是資料裡沒有任何配方產出的物品（例如木屑、食用油），先當外部輸入處理。權重存在這個瀏覽器，不屬於規劃檔。
        </MudText>
    </MudCollapse>

    @if (PinnableProducts.Count > 0)
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mb-1"
                   StartIcon="@(_showRecipes ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="() => _showRecipes = !_showRecipes">中間物品的做法（預設自動選最便宜@(_recipeOverrides.Count > 0 ? $"，已指定 {_recipeOverrides.Count} 項" : "")）</MudButton>
        <MudCollapse Expanded="_showRecipes">
            <div class="cost-weights cost-recipes">
                @foreach (var id in PinnableProducts)
                {
                    var pid = id;
                    <MudSelect T="string" Label="@ProductName(pid)" Value="@(_recipeOverrides.GetValueOrDefault(pid, ""))" ValueChanged="v => OnRecipeChosen(pid, v)"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem T="string" Value="@("")">自動（最便宜）</MudSelectItem>
                        @foreach (var recipeId in Calculator.RecipesProducing(pid))
                        {
                            var rid = recipeId;
                            <MudSelectItem T="string" Value="@rid">@MachineName(rid) · @RecipeName(rid)</MudSelectItem>
                        }
                    </MudSelect>
                }
            </div>
            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-2">
                只列出目前結果用到、而且有兩種以上做法的中間物品。指定後整張表都用你選的做法重算；選回「自動」就恢復取最便宜的。指定的做法存在這個瀏覽器。
            </MudText>
        </MudCollapse>
    }

    @if (string.IsNullOrEmpty(_productId) || _report is null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">請先選擇目標物品。</MudText>
    }
    else if (_report.IsExternal)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">資料裡沒有任何配方產出「@ProductName(_report.ProductId)」，先當外部輸入處理。</MudText>
    }
    else
    {
        <MudTable Items="_report.Routes" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None" Class="cost-table" T="RouteCost">
            <HeaderContent>
                <MudTh>配方</MudTh>
                <MudTh><MudTableSortLabel SortBy="@(new Func<RouteCost, object>(r => r.WeightedCost))" InitialDirection="SortDirection.Ascending">加權成本</MudTableSortLabel></MudTh>
                <MudTh>比最便宜多</MudTh>
                <MudTh>原料（每 1 單位）</MudTh>
                <MudTh>副產品（每 1 單位）</MudTh>
                <MudTh><MudTableSortLabel SortBy="@(new Func<RouteCost, object>(r => r.PowerKw))">耗電 kW</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@(new Func<RouteCost, object>(r => r.Workers))">工人</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="@(new Func<RouteCost, object>(r => r.Maintenance.Sum(m => m.PerMinute)))">維修（每分）</MudTableSortLabel></MudTh>
                <MudTh>機器</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="配方">
                    <span class="cost-recipe">@MachineName(context.RecipeId) · @RecipeName(context.RecipeId)</span>
                    @if (_recipes.TryGetValue(context.RecipeId, out var routeRecipe) && routeRecipe.Locked)
                    {
                        <MudChip T="string" Size="Size.Small" Class="ml-1">未解鎖</MudChip>
                    }
                    @if (context == _report.Routes[0])
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-1">最便宜</MudChip>
                    }
                    @foreach (var step in context.Steps)
                    {
                        <div class="cost-note">
                            上游：@ProductName(step.ProductId) ← @RecipeName(step.RecipeId)@(step.Pinned ? "（指定）" : "")
                            @if (step.Alternatives is { Count: > 0 })
                            {
                                <span>；其他做法（每 1 單位@(ProductName(step.ProductId)) 的加權成本差）：@string.Join("、", step.Alternatives.Take(3).Select(a => $"{RecipeName(a.RecipeId)} {SignedFormat(a.UnitCost - step.UnitCost)}"))@(step.Alternatives.Count > 3 ? $" 等 {step.Alternatives.Count} 種" : "")</span>
                            }
                        </div>
                    }
                    @foreach (var warning in context.Warnings)
                    {
                        <div class="cost-note cost-warning">@warning</div>
                    }
                </MudTd>
                <MudTd DataLabel="加權成本">@Format(context.WeightedCost)</MudTd>
                <MudTd DataLabel="比最便宜多">@Difference(context)</MudTd>
                <MudTd DataLabel="原料">
                    @foreach (var raw in context.RawInputs)
                    {
                        <div>@ProductName(raw.ProductId)@(Calculator.IsExternal(raw.ProductId) ? "（外部）" : "") @Format(raw.Quantity)</div>
                    }
                </MudTd>
                <MudTd DataLabel="副產品">
                    @if (context.Byproducts.Count == 0)
                    {
                        <span class="mud-text-secondary">—</span>
                    }
                    @foreach (var by in context.Byproducts)
                    {
                        <div>@ProductName(by.ProductId) @Format(by.Quantity)</div>
                    }
                </MudTd>
                <MudTd DataLabel="耗電 kW">@Format(context.PowerKw)</MudTd>
                <MudTd DataLabel="工人">@Format(context.Workers)</MudTd>
                <MudTd DataLabel="維修（每分）">
                    @if (context.Maintenance.Count == 0)
                    {
                        <span class="mud-text-secondary">—</span>
                    }
                    @foreach (var m in context.Maintenance)
                    {
                        <div>@m.Type @Format(m.PerMinute)</div>
                    }
                </MudTd>
                <MudTd DataLabel="機器">
                    @foreach (var m in context.Machines)
                    {
                        <div>@MachineNameById(m.MachineId) · @RecipeName(m.RecipeId) @Format(m.Count)</div>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {

    private string? _productId;
    private Dictionary<string, double> _weights = new();
    private CostReport? _report;
    private bool _showWeights;
    private bool _showRecipes;
    // 使用者指定的中間物品做法（物品 id → 配方 id）；沒有的物品取加權成本最低的
    private Dictionary<string, string> _recipeOverrides = new();
    private Dictionary<string, Product> _products = new();
    private Dictionary<string, Recipe> _recipes = new();

    protected override void OnInitialized()
    {
        _products = Data.Products.ToDictionary(p => p.Id);
        _recipes = Data.Recipes.ToDictionary(r => r.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // 壞掉或沒有的資料一律用預設值（權重全部 1、沒有指定做法）
        _weights = await Storage.GetJsonAsync(StorageKeys.CostWeights, new Dictionary<string, double>());
        _recipeOverrides = await Storage.GetJsonAsync(StorageKeys.CostRecipes, new Dictionary<string, string>());

        var product = await Storage.GetStringAsync(StorageKeys.CostProduct);
        if (product is not null && Calculator.TargetProductIds.Contains(product))
            _productId = product;

        Recalculate();
        StateHasChanged();
    }

    private async Task OnProductChosen(string? id)
    {
        _productId = string.IsNullOrEmpty(id) ? null : id;
        Recalculate();
        if (_productId is null)
            await Storage.RemoveAsync(StorageKeys.CostProduct);
        else
            await Storage.SetStringAsync(StorageKeys.CostProduct, _productId);
    }

    private async Task OnWeightChanged(string productId, double weight)
    {
        _weights[productId] = Math.Max(0, weight);
        Recalculate();
        await Storage.SetJsonAsync(StorageKeys.CostWeights, _weights);
    }

    private async Task OnRecipeChosen(string productId, string? recipeId)
    {
        if (string.IsNullOrEmpty(recipeId))
            _recipeOverrides.Remove(productId);
        else
            _recipeOverrides[productId] = recipeId;
        Recalculate();
        await Storage.SetJsonAsync(StorageKeys.CostRecipes, _recipeOverrides);
    }

    private void Recalculate() =>
        _report = string.IsNullOrEmpty(_productId) ? null : Calculator.Calculate(_productId, _weights, _recipeOverrides);

    /// <summary>可以指定做法的中間物品：目前結果用到、有兩種以上做法的，加上已經指定的（指定後才不會從清單消失）。</summary>
    private List<string> PinnableProducts =>
        (_report?.Routes.SelectMany(r => r.Steps).Select(s => s.ProductId) ?? [])
            .Concat(_recipeOverrides.Keys)
            .Distinct()
            .Where(id => Calculator.RecipesProducing(id).Count >= 2)
            .ToList();

    /// <summary>這一列比最便宜的那一列多多少（數值與百分比）。</summary>
    private string Difference(RouteCost route)
    {
        var cheapest = _report!.Routes.Min(r => r.WeightedCost);
        var diff = route.WeightedCost - cheapest;
        if (diff <= 1e-9)
            return "—";
        return cheapest > 1e-9 ? $"+{Format(diff)}（+{diff / cheapest:P0}）" : $"+{Format(diff)}";
    }

    private static string SignedFormat(double value) => value >= 0 ? $"+{Format(value)}" : Format(value);

    private Task<IEnumerable<string>> Search(string? text, CancellationToken ct) =>
        Task.FromResult(Calculator.TargetProductIds
            .Where(id => string.IsNullOrWhiteSpace(text)
                         || ProductName(id).Contains(text, StringComparison.OrdinalIgnoreCase)
                         || id.Contains(text, StringComparison.OrdinalIgnoreCase)));

    private double WeightOf(string id) => _weights.TryGetValue(id, out var w) ? w : 1;

    private string ProductName(string? id) => id is not null && _products.TryGetValue(id, out var p) ? p.Name : id ?? "";

    private string RecipeName(string id) => _recipes.TryGetValue(id, out var r) ? r.Name : id;

    private string MachineName(string recipeId) => Data.Machines.FirstOrDefault(m => m.CanRun(recipeId))?.Name ?? "—";

    private string MachineNameById(string id) => Data.Machines.FirstOrDefault(m => m.Id == id)?.Name ?? id;

    private static string Format(double value) => value.ToString("0.###");
}
