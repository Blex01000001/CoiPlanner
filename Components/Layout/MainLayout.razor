@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* 不使用頂端 App Bar，讓畫面（尤其是產線規劃的畫布）佔滿整個視窗；選單由左上角的浮動按鈕開啟 *@
    <MudIconButton Class="app-menu-button" Icon="@Icons.Material.Filled.Menu" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small" OnClick="@(() => _drawerOpen = true)" aria-label="開啟選單" />
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Temporary" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">CoiPlanner</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="app-content py-4">
        @Body
    </MudContainer>
</MudLayout>

<div id="blazor-error-ui">
    發生未預期的錯誤。
    <a href="" class="reload">重新載入</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    // 選單是浮在畫面上的抽屜，換頁後自動收起
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
