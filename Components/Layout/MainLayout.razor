@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-2">CoiPlanner 產線規劃</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    發生未預期的錯誤。
    <a href="" class="reload">重新載入</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        _drawerOpen = !IsPlanner(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    // 產線規劃頁的畫布要佔滿視窗，進入時自動收起選單；需要時仍可用左上角按鈕打開
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (IsPlanner(e.Location))
        {
            _drawerOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private bool IsPlanner(string uri) =>
        Navigation.ToBaseRelativePath(uri).StartsWith("planner", StringComparison.OrdinalIgnoreCase);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
