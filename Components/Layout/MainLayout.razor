@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* 不使用頂端 App Bar，讓畫面（尤其是產線規劃的畫布）佔滿整個視窗；換頁按鈕浮在左側 *@
    <div class="app-nav">
        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Variant="Variant.Filled" Size="Size.Small"
                       Color="@(OnPlanner ? Color.Primary : Color.Default)" Class="@(OnPlanner ? null : "app-nav-idle")" Href="@Navigation.BaseUri" title="產線規劃" aria-label="產線規劃" />
        <MudIconButton Icon="@Icons.Material.Filled.MenuBook" Variant="Variant.Filled" Size="Size.Small"
                       Color="@(OnPlanner ? Color.Default : Color.Primary)" Class="@(OnPlanner ? "app-nav-idle" : null)" Href="@($"{Navigation.BaseUri}data")" title="資料瀏覽" aria-label="資料瀏覽" />
    </div>
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="app-content py-4">
        @Body
    </MudContainer>
</MudLayout>

<div id="blazor-error-ui">
    發生未預期的錯誤。
    <a href="" class="reload">重新載入</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // 產線規劃是起始頁（/ 與 /planner），其餘（目前只有 /data）是資料瀏覽
    private bool OnPlanner => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') is "" or "planner";
}
