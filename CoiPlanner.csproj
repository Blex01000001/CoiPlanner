<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Domain 與 tests 是獨立專案，不讓 Web 專案的預設 glob 把它們編進來 -->
  <ItemGroup>
    <Compile Remove="Domain/**;tests/**" />
    <Content Remove="Domain/**;tests/**" />
    <None Remove="Domain/**;tests/**" />
  </ItemGroup>

  <!-- 遊戲資料編進組件裡（靜態網站沒有資料夾可以列舉，也不必再多一次網路請求）；改了 Data/*.json 要重新建置 -->
  <ItemGroup>
    <EmbeddedResource Include="Data/*.json" LogicalName="Data/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Domain/CoiPlanner.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.32" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.32" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

</Project>
